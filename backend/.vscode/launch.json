{
    "version": "0.2.0",
    "configurations": [
        // 1) Run Agent
        {
            "name": "Run Agent",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/agent/main.py",
            "console": "integratedTerminal",
            "args": [
                "http://localhost:5001/c2/api/v1",
                "http://localhost:5003"
            ],
            "envFile": "${workspaceFolder}/.env"
        },
        // 2) Run Agent App
        {
            "name": "Run Agent App",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/agent/agent_ui_app.py",
            "console": "integratedTerminal",
            "args": [
                "http://localhost:5001/c2/api/v1",
                "http://localhost:5003"
            ],
            "envFile": "${workspaceFolder}/.env"
        },
        // 3) Run ChatGPT Shell
        {
            "name": "Run ChatGPT Shell",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/cybersecurity_shell.py",
            "console": "integratedTerminal",
            "envFile": "${workspaceFolder}/.env"
        },
        // 4) Run Grok Shell
        {
            "name": "Run Grok Shell",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/grok_shell.py",
            "console": "integratedTerminal",
            "envFile": "${workspaceFolder}/.env"
        },
        // 5) Run Web Server (FastAPI/Uvicorn) with Hot Reload
        {
            "name": "Run Web Server with Hot Reload",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "web_server.app:app",
                "--host",
                "localhost",
                "--port",
                "5002",
                "--reload"
            ],
            "console": "integratedTerminal",
            "envFile": "${workspaceFolder}/.env"
        },
        // 6) Run C2 Server (FastAPI/Uvicorn) with Hot Reload
        {
            "name": "Run C2 Server (FastAPI & WebSocket) with Hot Reload",
            "type": "python",
            "request": "launch",
            "module": "c2_server.app",
            "console": "integratedTerminal",
            "justMyCode": true,
            "envFile": "${workspaceFolder}/.env",
            "args": []
        },
        // 7) Run Socket.IO Server (Gevent) with Hot Reload
        {
            "name": "Run Socket.IO Server with Hot Reload",
            "type": "python",
            "request": "launch",
            "module": "uvicorn", // Use Uvicorn to run the ASGI app
            "console": "integratedTerminal",
            "justMyCode": true,
            "envFile": "${workspaceFolder}/.env",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            },
            "args": [
                "c2_server.c2_socket_server:sio_app", // ASGI app to load
                "--host",
                "localhost",
                "--port",
                "5003",
                "--reload" // Enable hot reload
            ]
        }
    ],
    "compounds": [
        // Run all three servers at once, each in its own process:
        {
            "name": "Run All Servers (Hot Reload)",
            "configurations": [
                "Run Web Server with Hot Reload",
                "Run C2 Server (FastAPI & WebSocket) with Hot Reload",
            ]
        }
    ]
}