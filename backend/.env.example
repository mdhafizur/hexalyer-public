# Database settings
MONGO_URI=mongodb://localhost:27017/
MONGO_DB=hexalayer

# Flask server settings
WEB_SERVER_HOST=localhost
C2_SERVER_HOST=localhost
WEB_SERVER_PORT=5000
C2_SERVER_PORT=5001

# Socket listener settings
SOCKET_PROTOCOL=http
SOCKET_HOST=localhost
SOCKET_PORT=5003

# Logging settings
LOG_LEVEL=DEBUG
LOG_DIR=logs
DEBUG=true

# AI provider API keys
OPENAI_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=

# WebHex / ZAP integration
WEBHEX_URL=http://localhost:8090/JSON
WEBHEX_API_KEY=

# Email (SMTP) settings
GMAIL_USER=
GMAIL_PASSWORD=

# Auth / JWT settings
SECRET_KEY=
ALGORITHM=HS256
REFRESH_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
AUTH_ENABLED=true

# Firebase
BASE_URL=
FIREBASE_CREDENTIALS_PATH=./firebase/credentials/service-account.json

# CORS / cookie settings
ALLOW_ORIGINS=http://localhost:5173
# true for production, false for development
COOKIE_SECURE=false
# Lax, None, or Strict
COOKIE_SAMESITE=Lax
# 30 minutes in seconds
COOKIE_MAX_AGE=1800
